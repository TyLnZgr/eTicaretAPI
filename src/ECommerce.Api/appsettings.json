{
  "ConnectionStrings": {
    "ECommerceDatabase": "Data Source=ecommerce.db;Foreign Keys=True",
    "Redis": "localhost:6379,abortConnect=false,connectRetry=1,connectTimeout=1000,syncTimeout=1000,asyncTimeout=1000"
  },
  "Outbox": {
    "Enabled": true,
    "BatchSize": 20,
    "PollingInterval": "00:00:05",
    "MaximumAttempts": 5,
    "LeaseDuration": "00:01:00"
  },
  "Messaging": {
    "Provider": "InProcess",
    "RabbitMq": {
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "ecommerce",
      "Password": "ecommerce_dev_only",
      "VirtualHost": "/",
      "Exchange": "ecommerce.events",
      "Queue": "ecommerce.api",
      "DeadLetterExchange": "ecommerce.events.dead-letter",
      "DeadLetterQueue": "ecommerce.api.dead-letter",
      "PrefetchCount": 10,
      "InitialConnectionRetryDelay": "00:00:05"
    }
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 300,
      "Window": "00:01:00"
    },
    "Authentication": {
      "PermitLimit": 10,
      "Window": "00:01:00",
      "SegmentsPerWindow": 6
    },
    "Mutation": {
      "TokenLimit": 30,
      "TokensPerPeriod": 5,
      "ReplenishmentPeriod": "00:00:10"
    }
  },
  "OutputCache": {
    "Provider": "Memory",
    "Redis": {
      "InstanceName": "ecommerce:output-cache:",
      "FailOpen": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
