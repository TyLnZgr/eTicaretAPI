{
  "ConnectionStrings": {
    "ECommerceDatabase": "Data Source=ecommerce.db;Foreign Keys=True"
  },
  "Outbox": {
    "Enabled": true,
    "BatchSize": 20,
    "PollingInterval": "00:00:05",
    "MaximumAttempts": 5,
    "LeaseDuration": "00:01:00"
  },
  "Messaging": {
    "Provider": "InProcess",
    "RabbitMq": {
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "ecommerce",
      "Password": "ecommerce_dev_only",
      "VirtualHost": "/",
      "Exchange": "ecommerce.events",
      "Queue": "ecommerce.api",
      "DeadLetterExchange": "ecommerce.events.dead-letter",
      "DeadLetterQueue": "ecommerce.api.dead-letter",
      "PrefetchCount": 10,
      "InitialConnectionRetryDelay": "00:00:05"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
