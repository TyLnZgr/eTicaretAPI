@ECommerce.Api_HostAddress = http://localhost:5080
@accessToken = paste-access-token-here
@refreshToken = paste-refresh-token-here
@adminAccessToken = paste-admin-access-token-here
@idempotencyKey = order-1-payment-attempt-1
@paymentId = paste-payment-id-here
@notificationId = paste-notification-id-here

GET {{ECommerce.Api_HostAddress}}/
Accept: application/json

###

POST {{ECommerce.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "customer@example.com",
  "password": "StrongPass1!"
}

###

POST {{ECommerce.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "customer@example.com",
  "password": "StrongPass1!"
}

###

POST {{ECommerce.Api_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###

GET {{ECommerce.Api_HostAddress}}/api/auth/manage/info
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{ECommerce.Api_HostAddress}}/api/addresses
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{ECommerce.Api_HostAddress}}/api/addresses
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "label": "Home",
  "recipientFullName": "Taylor Customer",
  "phoneNumber": "+90 555 111 22 33",
  "addressLine1": "Example Street No: 10",
  "addressLine2": "Floor 2",
  "district": "Kadikoy",
  "city": "Istanbul",
  "postalCode": "34710",
  "countryCode": "TR",
  "isDefault": true
}

###

PUT {{ECommerce.Api_HostAddress}}/api/addresses/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "label": "Office",
  "recipientFullName": "Taylor Customer",
  "phoneNumber": "+90 555 111 22 33",
  "addressLine1": "Business Avenue No: 20",
  "addressLine2": null,
  "district": "Besiktas",
  "city": "Istanbul",
  "postalCode": "34340",
  "countryCode": "TR",
  "isDefault": false
}

###

DELETE {{ECommerce.Api_HostAddress}}/api/addresses/1
Authorization: Bearer {{accessToken}}

###

GET {{ECommerce.Api_HostAddress}}/api/cart
Authorization: Bearer {{accessToken}}
Accept: application/json

###

PUT {{ECommerce.Api_HostAddress}}/api/cart/items/1
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "quantity": 2
}

###

POST {{ECommerce.Api_HostAddress}}/api/cart/checkout
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "addressId": 1
}

###

DELETE {{ECommerce.Api_HostAddress}}/api/cart/items/1
Authorization: Bearer {{accessToken}}

###

DELETE {{ECommerce.Api_HostAddress}}/api/cart
Authorization: Bearer {{accessToken}}

###

GET {{ECommerce.Api_HostAddress}}/api/categories
Accept: application/json

###

GET {{ECommerce.Api_HostAddress}}/api/categories/1
Accept: application/json

###

POST {{ECommerce.Api_HostAddress}}/api/categories
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "name": "Electronics",
  "isActive": true
}

###

PUT {{ECommerce.Api_HostAddress}}/api/categories/2
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "name": "Consumer Electronics",
  "isActive": true
}

###

DELETE {{ECommerce.Api_HostAddress}}/api/categories/1
Authorization: Bearer {{adminAccessToken}}

###

DELETE {{ECommerce.Api_HostAddress}}/api/categories/999
Authorization: Bearer {{adminAccessToken}}

###

GET {{ECommerce.Api_HostAddress}}/api/products/1
Accept: application/json

###

GET {{ECommerce.Api_HostAddress}}/api/products
Accept: application/json

###

GET {{ECommerce.Api_HostAddress}}/api/products/999
Accept: application/json

###

GET {{ECommerce.Api_HostAddress}}/api/products/not-a-number
Accept: application/json

###

POST {{ECommerce.Api_HostAddress}}/api/products
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "name": "USB-C Hub",
  "price": 899.90,
  "stockQuantity": 15,
  "categoryId": 1,
  "isActive": true
}

###

POST {{ECommerce.Api_HostAddress}}/api/orders
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "addressId": 1,
  "items": [
    {
      "productId": 1,
      "quantity": 2
    }
  ]
}

###

GET {{ECommerce.Api_HostAddress}}/api/orders/1
Accept: application/json
Authorization: Bearer {{accessToken}}

###

GET {{ECommerce.Api_HostAddress}}/api/orders?status=Pending&page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{accessToken}}

###

POST {{ECommerce.Api_HostAddress}}/api/orders/1/payments
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{idempotencyKey}}
Content-Type: application/json

{
  "paymentMethodToken": "tok_success"
}

###

GET {{ECommerce.Api_HostAddress}}/api/orders/1/payments/{{paymentId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{ECommerce.Api_HostAddress}}/api/notifications?unreadOnly=true&page=1&pageSize=20
Authorization: Bearer {{accessToken}}
Accept: application/json

###

PATCH {{ECommerce.Api_HostAddress}}/api/notifications/{{notificationId}}/read
Authorization: Bearer {{accessToken}}

###

PATCH {{ECommerce.Api_HostAddress}}/api/orders/1/status
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "status": "Cancelled"
}

###

PATCH {{ECommerce.Api_HostAddress}}/api/admin/orders/1/status
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "status": "Paid"
}

###

GET {{ECommerce.Api_HostAddress}}/api/admin/orders?status=Pending&page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{adminAccessToken}}

###

GET {{ECommerce.Api_HostAddress}}/api/admin/orders?customerEmail=customer@example.com
Accept: application/json
Authorization: Bearer {{adminAccessToken}}

###

PUT {{ECommerce.Api_HostAddress}}/api/products/2
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "name": "Ergonomic Wireless Mouse",
  "price": 1499.90,
  "categoryId": 1,
  "isActive": true
}

###

PUT {{ECommerce.Api_HostAddress}}/api/products/999
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "name": "Unknown Product",
  "price": 100,
  "categoryId": 1,
  "isActive": true
}

###

PATCH {{ECommerce.Api_HostAddress}}/api/products/2/stock
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "quantityDelta": -2,
  "reason": "Customer order"
}

###

GET {{ECommerce.Api_HostAddress}}/api/products/2/stock-movements
Accept: application/json
Authorization: Bearer {{adminAccessToken}}

